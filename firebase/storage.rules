rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && userDoc().exists;
    }

    function userBusinessId() {
      return userExists() ? userDoc().data.businessId : '';
    }

    function userRole() {
      return userDoc().data.role;
    }

    function businessDoc(businessId) {
      return firestore.get(/databases/(default)/documents/businesses/$(businessId));
    }

    function businessExists(businessId) {
      return businessDoc(businessId).exists;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && businessExists(businessId)
        && businessDoc(businessId).data.ownerId == request.auth.uid;
    }

    function isMember(businessId) {
      return isBusinessOwner(businessId)
        || (userExists() && userBusinessId() == businessId);
    }

    /// Owner / admin / manager may upload; employee role is read-only for media.
    function canWriteMedia(businessId) {
      return isBusinessOwner(businessId)
        || (userExists()
            && userBusinessId() == businessId
            && userRole() in ['owner', 'admin', 'manager']);
    }

    function underSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function allowMediaWrite(businessId) {
      return canWriteMedia(businessId) && underSizeLimit() && isImageOrPdf();
    }

    // Product images
    match /businesses/{businessId}/products/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    // Branding & site assets
    match /businesses/{businessId}/logo/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    match /businesses/{businessId}/cover/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    match /businesses/{businessId}/background/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    match /businesses/{businessId}/site/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    // Employee photos
    match /businesses/{businessId}/employees/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if allowMediaWrite(businessId);
    }

    // Deny any other path under businesses/
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if isMember(businessId);
      allow write: if false;
    }

    match /social_posts/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
